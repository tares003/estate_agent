# ── Local development environment ────────────────────────────────────────────
# Copy the values you need into apps/web/.env.local (Next.js) — .env files are
# gitignored; only this example is committed.
#
# Start the local stack first:
#   docker compose -f infrastructure/dev/docker-compose.yml up -d
#   node infrastructure/dev/setup-dev-db.mjs

# PostgreSQL 16 + PostGIS (infrastructure/dev/docker-compose.yml, host port 5461)
DATABASE_URL=postgresql://estate:estate@localhost:5461/estate

# Redis — BullMQ queue + cache (host port 6380). Needed by apps/workers.
REDIS_URL=redis://localhost:6380

# ── Optional — feature activation (see CLAUDE.md §9 + docs/runbooks) ─────────
# Better Auth runtime (EPIC-N). Requires a SEPARATE BYPASSRLS Postgres role —
# see the EPIC-N notes; leave unset to keep the auth runtime dormant in dev.
# AUTH_DATABASE_URL=
# BETTER_AUTH_SECRET=

# Cloudflare Turnstile (public forms verify server-side; dev fails open only
# where the code explicitly allows it — see packages' turnstile helper).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Contractor / feedback magic-link token secrets (HMAC).
# CONTRACTOR_LINK_SECRET=
# FEEDBACK_LINK_SECRET=
